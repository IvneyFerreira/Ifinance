# IFinance — variáveis de ambiente do backend (copie para .env e ajuste).
# NUNCA versione o .env com chaves reais.

# Porta HTTP do servidor
PORT=5060

# Diretório do build web do Flutter
WEB_DIR=./build/web

# Provedor compatível com OpenAI (a chave fica SOMENTE no servidor)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-sua-chave-aqui
IFINANCE_LLM_MODEL=gpt-5.4-mini

# CORS: "*" para liberar tudo, ou lista de origens separada por vírgula
IFINANCE_ALLOWED_ORIGINS=https://seu-app.exemplo.com

# Limite de requisições por minuto por IP para o /api/assessor (0 = desliga)
IFINANCE_RATE_LIMIT=30

# ---------------------------------------------------------------------------
# Passkeys / WebAuthn (login sem senha) — cap. 71
# ---------------------------------------------------------------------------
# Domínio do relying party (SEM esquema, SEM barra). Obrigatório para habilitar.
# Para Android: o app precisa publicar /.well-known/assetlinks.json neste domínio
# com o package name e o fingerprint SHA-256 do certificado de assinatura.
IFINANCE_RP_ID=seu-app.exemplo.com
IFINANCE_RP_NAME=IFinance

# Origens HTTP adicionais autorizadas (além de https://<RP_ID> e localhost).
# Útil para dev (ex.: http://192.168.0.10:5060). Separadas por vírgula.
IFINANCE_PASSKEY_ORIGINS=

# Digital Asset Links (Android): pacote + fingerprints SHA-256 do certificado.
# Vários fingerprints separados por vírgula (upload key + Play App Signing).
IFINANCE_ANDROID_PACKAGE=com.ifinance.app
IFINANCE_ANDROID_SHA256=

# Arquivo onde as chaves públicas das passkeys são persistidas.
IFINANCE_PASSKEY_STORE=./passkeys.json

